# ─── Wave Configuration ───
# Copy this to .env and edit before running.
# Used by both docker compose (production) and docker compose -f docker-compose.dev.yml (development).

# ─── Server ───
PORT=5000

# ─── Docker Production ───
# Port for the Wave web UI (accessible at http://localhost:WAVE_PORT)
WAVE_PORT=3742

# ─── MongoDB ───
# Overridden automatically by docker-compose. Only change for external MongoDB.
MONGO_URI=mongodb://localhost:27017/wave

# ─── Auth & Encryption ───
# Generate strong secrets with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
JWT_SECRET=
ENCRYPTION_KEY=

# ─── LLM Configuration (BYOM — Bring Your Own Model) ───
# Recommended: qwen_qwen3.5-4b via LM Studio (~4GB VRAM)
# Use host.docker.internal to reach LLM running on your host machine.
LLM_BASE_URL=http://host.docker.internal:1234/v1
LLM_API_KEY=lm-studio
LLM_MODEL=qwen_qwen3.5-4b

# ─── Embedding Model (for saved query similarity search) ───
# Falls back to LLM_BASE_URL/LLM_API_KEY if not set
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-all-minilm-l6-v2-embedding

# ─── Agent Tuning (all optional, sensible defaults) ───
# Max rows a query tool can return before erroring
# MAX_QUERY_ROWS=50
# Token count that triggers conversation summarization
# SUMMARIZATION_TOKEN_LIMIT=4000
# Timeout for a single agent invocation (ms)
# AGENT_TIMEOUT_MS=175000
# Max tool-call loops before the agent stops
# AGENT_RECURSION_LIMIT=25
# Minimum cosine similarity for saved query matching (0–1)
# SAVED_QUERY_MIN_SCORE=0.6
# Idle time before auto-disconnecting a database connection (ms, default 30min)
# CONNECTION_IDLE_TIMEOUT_MS=1800000

# ─── Guest Cleanup ───
# Guest accounts older than this are automatically deleted (default: 24h)
GUEST_TTL_HOURS=24

# ─── Optional: LangSmith Tracing ───
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=Wave
